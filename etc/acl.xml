<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::system">
                    <resource id="Magento_Backend::tools">
                        <!-- Logs carry customer data and API payloads: grant to as few roles as possible. -->
                        <resource id="MolokaiStudio_LogViewer::logs" title="Log Viewer" translate="title" sortOrder="100">
                            <resource id="MolokaiStudio_LogViewer::download" title="Download Log Files" translate="title"
                                      sortOrder="10"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
