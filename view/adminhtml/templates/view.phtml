                color: #d4d4d4; font-size: 1.2rem; line-height: 1.5; white-space: pre;"></pre>
</div>
<script type="text/x-magento-init">
    {
        "#molokaistudio-log-viewer": {
            "MolokaiStudio_LogViewer/js/log-view": <?= /* @noEscape */ json_encode(
                $viewModel->getWidgetConfig(),
                JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR
            ) ?>
        }
    }
</script>
