<?php

declare(strict_types=1);

/** @var \Magento\Backend\Block\Template $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \MolokaiStudio\LogViewer\ViewModel\LogList $viewModel */
$viewModel = $block->getData('view_model');
$files = $viewModel->getFiles();
$canDownload = $viewModel->canDownload();
?>
<?php if ($files === []): ?>
    <div class="message message-notice">
        <div><?= $escaper->escapeHtml(__('There are no log files in var/log.')) ?></div>
    </div>
<?php else: ?>
    <div class="admin__data-grid-wrap">
        <table class="data-grid">
            <thead>
            <tr>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('File')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Size')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Modified')) ?></th>
                <th class="data-grid-th"><?= $escaper->escapeHtml(__('Actions')) ?></th>
            </tr>
            </thead>
            <tbody>
            <?php foreach ($files as $index => $file): ?>
                <tr class="<?= $index % 2 ? '_odd-row' : '' ?>">
                    <td>
                        <a href="<?= $escaper->escapeUrl($viewModel->getViewUrl($file)) ?>">
                            <?= $escaper->escapeHtml($file->name) ?>
                        </a>
                    </td>
                    <td><?= $escaper->escapeHtml($viewModel->formatSize($file->size)) ?></td>
                    <td><?= $escaper->escapeHtml($viewModel->formatModifiedAt($file)) ?></td>
                    <td>
                        <a href="<?= $escaper->escapeUrl($viewModel->getViewUrl($file)) ?>">
                            <?= $escaper->escapeHtml(__('View')) ?>
                        </a>
                        <?php if ($canDownload): ?>
                            &nbsp;|&nbsp;
                            <a href="<?= $escaper->escapeUrl($viewModel->getDownloadUrl($file)) ?>">
                                <?= $escaper->escapeHtml(__('Download')) ?>
                            </a>
                        <?php endif; ?>
                    </td>
                </tr>
            <?php endforeach; ?>
            </tbody>
        </table>
    </div>
<?php endif; ?>
